# --- Sanity CMS ---
# Create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Optional: read token for private datasets / drafts
# SANITY_API_READ_TOKEN=

# --- Resend (contact form) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=staff@example.com
# Verified sender in Resend (defaults to onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=Okotoks Humane Society <onboarding@resend.dev>

# --- Google Analytics ---
# Leave empty to disable the tracking snippet
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
